# Rename this file to .env before running the server

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/secure_card

# Port for the Express server
PORT=5000

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret

# 32-byte (64 hex char) key used for AES-256-GCM encryption of transaction descriptions
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# Secret used to create the searchable keyword HMAC (must stay constant so search still matches)
HMAC_SECRET_KEY=change_this_hmac_secret_too

# In production, set this to your deployed frontend's URL (for CORS).
# Leave unset for local development.
# FRONTEND_URL=https://securecard.vercel.app
