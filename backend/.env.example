# 32-byte (64 hex char) key used for AES-256-GCM encryption of transaction descriptions
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# Secret used to create the searchable keyword HMAC (must stay constant so search still matches)
HMAC_SECRET_KEY=change_this_hmac_secret_too

# In production, set this to your deployed frontend's URL (for CORS).
# Leave unset for local development.
